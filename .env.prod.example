# ╔══════════════════════════════════════════════════════════════════╗
# ║  .env.prod.example — Template biến môi trường PRODUCTION        ║
# ║  Copy file này thành .env.prod trên server và điền giá trị thật ║
# ║  TUYỆT ĐỐI KHÔNG đặt giá trị thật vào file .example này!       ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Môi trường ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ─── Database PostgreSQL (PRODUCTION) ──────────────────────────────
# Option A: Kết nối Supabase (Free tier / Paid)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
#
# Option B: Kết nối Neon PostgreSQL (Serverless)
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxxx.us-east-2.aws.neon.tech/edupay_prod_db?sslmode=require
#
# Option C: VPS riêng (Railway / Render / Server thuê VN)
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-server-ip:5432/edupay_prod_db

SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_WITH_PROD_HOST:5432/edupay_prod_db
SPRING_DATASOURCE_USERNAME=REPLACE_WITH_PROD_USERNAME
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── JWT Security ──────────────────────────────────────────────────
# Tạo secret ngẫu nhiên 64 ký tự bằng lệnh:
# openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ─── CORS (chỉ domain thật của sản phẩm) ─────────────────────────
CORS_ALLOWED_ORIGINS=https://edupay.vn,https://www.edupay.vn

# ─── Zalo ZNS (Thông báo tự động) ─────────────────────────────────
ZALO_ACCESS_TOKEN=REPLACE_WITH_ZALO_OA_ACCESS_TOKEN
ZALO_OA_ID=REPLACE_WITH_ZALO_OA_ID

# ─── SePay / Casso Webhook (Auto gạch nợ) ─────────────────────────
SEPAY_WEBHOOK_SECRET=REPLACE_WITH_SEPAY_HMAC_SECRET
